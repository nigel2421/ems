{
  "name": "ems",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test src/__tests__/ci-ems.test.js",
    "test:e2e": "python -m pytest tests/e2e_selenium",
    "test:e2e:headed": "python -m pytest tests/e2e_selenium --headed",
    "test:e2e:live": "python -m pytest tests/e2e_selenium --env=live",
    "test:e2e:local": "python -m pytest tests/e2e_selenium --env=local",
    "test:e2e:report": "python -m pytest tests/e2e_selenium --html=tests/e2e_selenium/reports/report.html --self-contained-html",
    "verify:live": "node scripts/verify_live_system.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "4.5.2",
    "oxlint": "^1.79.0",
    "vite": "6.3.5"
  }
}
